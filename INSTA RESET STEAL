local alertSound = Instance.new("Sound")
alertSound.Name = "VontashAlert"
alertSound.SoundId = SOUND_ID
alertSound.Volume = 1
alertSound.Parent = SoundService

local function playAlert()
    local clone = alertSound:Clone()
    clone.Parent = SoundService
    clone:Play()
    clone.Ended:Connect(function()
        clone:Destroy()
    end)
    -- Cleanup if Ended never fires
    task.delay(10, function()
        if clone and clone.Parent then
            clone:Destroy()
        end
    end)
end

local function checkEggsForAlert()
    local container = workspace:FindFirstChild("RenderedEggs")
    if not container then
        -- Reset notifications when folder disappears
        notifiedEggs = {}
        return
    end

    local present = {}

    for _, egg in ipairs(container:GetChildren()) do
        if TARGET_EGGS[egg.Name] then
            present[egg.Name] = true
            if not notifiedEggs[egg.Name] then
                notifiedEggs[egg.Name] = true
                playAlert()
                statusLbl.Text = "🔔 " .. egg.Name .. " spawned!"
                statusLbl.TextColor3 = Color3.fromRGB(255, 200, 100)
                task.delay(3, function()
                    if statusLbl.Text:find("spawned!") then
                        statusLbl.TextColor3 = Color3.fromRGB(140, 140, 150)
                    end
                end)
            end
        end
    end

    -- Clear notified flags for eggs that are no longer present
    for name, _ in pairs(notifiedEggs) do
        if not present[name] then
            notifiedEggs[name] = nil
        end
    end
end

local function farmEgg(egg)
    farming = true
    statusLbl.Text = "Farming: " .. egg.Name
    statusLbl.TextColor3 = Color3.fromRGB(140, 140, 150)

    for i = 1, 10 do
        local root = getRoot()
        if not root then break end
        local cf = getPivot(egg)
        if not cf then break end
        root.CFrame = cf + Vector3.new(0, 3, 0)
        task.wait(0.05)
    end

    local prompt = getPickupPrompt(egg)
    if not prompt then
        statusLbl.Text = "No prompt found on " .. egg.Name
        farming = false
        return
    end

    statusLbl.Text = "Firing prompt..."
    holdPrompt(prompt, 1)

    if savedPosition then
        statusLbl.Text = "Tweening back..."
        local root = getRoot()
        if root then
            local info = TweenInfo.new(tweenDuration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
            local tween = TweenService:Create(root, info, { CFrame = savedPosition })
            tween:Play()
            tween.Completed:Wait()
        end
    end

    statusLbl.Text = "Farm cycle done"
    farming = false
end

local function autoFarmLoop()
    while autoFarmEnabled do
        if not farming then
            local target = findTargetEgg()
            if target then
                farmEgg(target)
            end
        end
        task.wait(0.5)
    end
end

