    end
end)

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local function parseLuck(text)
    if not text then return 0 end

    local s = tostring(text)
    local target = s:match("[/in]+%s*([%d%.]+%s*[%a]*)") or s
    local num, suffix = target:match("([%d%.]+)%s*([%a]*)")
    if not num then return 0 end

    local n = tonumber(num) or 0
    if suffix and suffix ~= "" then
        local mult = SUFFIX[suffix:lower()]
        if mult then return n * mult end
    end
    return n
end

local function getLuck(egg)
    local ok, value = pcall(function()
        local luck = egg.Handle.EggLuck.Luck
        return luck.ContentText ~= "" and luck.ContentText or luck.Text
    end)
    return ok and value or nil
end

local function getPivot(egg)
    if egg:IsA("Model") then
        local ok, pivot = pcall(function() return egg:GetPivot() end)
        if ok and pivot then return pivot end

        local part = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
        return part and part.CFrame or nil
    end

    if egg:IsA("BasePart") then
        return egg.CFrame
    end

    return nil
end

local function getPickupPrompt(egg)
    local ok, prompt = pcall(function()
        return egg.Inner.Pickup
    end)
    if ok and prompt then return prompt end

    local found = nil
    for _, child in ipairs(egg:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            found = child
            break
        end
    end
    return found
end

local function firePrompt(prompt)
    if not prompt then return end

    if type(fireproximityprompt) == "function" then
        pcall(function()
            fireproximityprompt(prompt)
        end)
        return
    end

    pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration)
        prompt:InputHoldEnd()
    end)
end

local function holdPrompt(prompt, duration)
    if not prompt then return end

    local endTime = tick() + duration
    while tick() < endTime do
        firePrompt(prompt)
        task.wait(0.05)
    end
end

local function teleportTo(egg)
    local root = getRoot()
    if not root then return end

    local cf = getPivot(egg)
    if not cf then return end

    root.CFrame = cf + Vector3.new(0, 3, 0)
end

local function findTargetEgg()
    local container = workspace:FindFirstChild("RenderedEggs")
    if not container then return nil end

    for _, egg in ipairs(container:GetChildren()) do
        if TARGET_EGGS[egg.Name] then
            return egg
        end
    end
    return nil
end

