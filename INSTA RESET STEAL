local function refresh()
    clearList()

    local container = workspace:FindFirstChild("RenderedEggs")
    if not container then
        statusLbl.Text = "RenderedEggs not found"
        return
    end

    local eggs = container:GetChildren()
    if #eggs == 0 then
        if not autoFarmEnabled then
            statusLbl.Text = "No eggs"
        end
        return
    end

    local entries = {}
    for _, egg in ipairs(eggs) do
        local luck = getLuck(egg)
        table.insert(entries, {
            egg = egg,
            luck = luck,
            value = parseLuck(luck),
        })
    end

    table.sort(entries, function(a, b)
        return a.value > b.value
    end)

    if not autoFarmEnabled then
        statusLbl.Text = #entries .. " eggs"
    end

    for i, entry in ipairs(entries) do
        makeRow(entry.egg, entry.luck, i)
    end
end

